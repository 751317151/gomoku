# 复制为 .env 后按需修改
HTTP_PORT=9000
WS_PORT=9001
# JAVA_OPTS=-Xms256m -Xmx768m

# HTTPS / WSS（配合 docker-compose.https.yml）
DOMAIN=game.example.com
ACME_EMAIL=admin@example.com
# 可选 AI 导师（OpenAI 兼容 Chat Completions，密钥仅服务端使用）
COACH_ENABLED=false
COACH_ENDPOINT=https://api.openai.com/v1/chat/completions
COACH_API_KEY=
COACH_MODEL=
# 运营治理管理令牌：留空则 /api/admin/moderation 整体关闭
ADMIN_TOKEN=
